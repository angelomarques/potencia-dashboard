# Cloudflare D1 (HTTP API from Vercel)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames (no scheme) allowed for Turnstile siteverify (e.g. localhost,127.0.0.1 or potencia-dashboard-nu.vercel.app,dashboard.potenciaapps.com.br)
TURNSTILE_HOSTNAMES=

# Optional
NEXT_PUBLIC_APP_NAME=Potencia Dashboard

# Cloudflare R2 (YouTube media) — GeoRealty-style names preferred
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
# CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Shorthand aliases also accepted by src/lib/r2/config.ts:
# R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET_NAME= R2_ENDPOINT= R2_ACCOUNT_ID=

# YouTube Data API OAuth (live publish). Without these, publish is dry-run only.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional dedicated key for encrypting channel refresh tokens in D1 (falls back to BETTER_AUTH_SECRET)
# YOUTUBE_TOKEN_KEY=

# PostHog (Help Center inbox query)
# POSTHOG_PERSONAL_API_KEY (PostHog query API bearer; server-only)
POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID (path segment for /api/projects/:project_id/query/)
POSTHOG_PROJECT_ID=
# NEXT_PUBLIC_POSTHOG_UI_HOST (app host, e.g. https://us.posthog.com; preferred API host)
NEXT_PUBLIC_POSTHOG_UI_HOST=
# NEXT_PUBLIC_POSTHOG_HOST (ingest host already used by sibling Potencia apps; if UI host is unset, map us.i.posthog.com -> https://us.posthog.com and eu.i.posthog.com -> https://eu.posthog.com, otherwise use this host)
NEXT_PUBLIC_POSTHOG_HOST=

# Daisy studio (AI UI-designer agent)
# Shared secret for inbound/outbound HMAC-SHA256 webhook signatures
DAISY_WEBHOOK_SECRET=
# Outbound webhook endpoint Daisy listens on (https)
DAISY_WEBHOOK_URL=
# Bearer token for Daisy to pull events via GET /api/daisy/events
DAISY_PULL_TOKEN=
# Owner email allowed to access /daisy dashboard
DAISY_OWNER_EMAIL=
# Comma-separated allowed preview hosts/wildcards (e.g. *.vercel.app, *.potenciaapps.com.br, localhost:3000)
DAISY_PREVIEW_ALLOWED_ORIGINS=
# Upstash Redis for rate limiting (sliding window fallback to memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret for cron trigger (e.g. delivering retry queue)
CRON_SECRET=
# Optional custom base URL for Cloudflare D1 HTTP API (defaults to https://api.cloudflare.com/client/v4)
D1_HTTP_BASE_URL=
